# Supabase Public Configuration (accessible in browser with RLS enforcement)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Configuration (NEVER expose to client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_CURRENCY=USD
NEXT_PUBLIC_STORE_NAME="Aerox Auto Parts"

